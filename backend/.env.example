# Copy to .env and adjust. NEVER commit real secrets.
DJANGO_SETTINGS_MODULE=unilect.settings.dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
# Optional separate keys (default to SECRET_KEY-derived values)
JWT_SIGNING_KEY=
DEVICE_ID_HASH_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=postgres://unilect:unilect-dev-only@127.0.0.1:5432/unilect

# Web dashboard origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Private (non-public) storage for uploaded content
PRIVATE_MEDIA_ROOT=./var/private_media
# Production with nginx: internal location prefix used for X-Accel-Redirect (empty = stream from Django)
PRIVATE_MEDIA_ACCEL_PREFIX=

# Email (password reset)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=UniLect <no-reply@example.com>
# Deep link / web URL the reset email points to. {uid} and {token} are substituted.
PASSWORD_RESET_URL_TEMPLATE=unilect://app/reset-password?uid={uid}&token={token}

# Cache for throttles, login lockouts and settings. REQUIRED to be shared (redis://...) with >1 worker;
# `check --deploy` warns (unilect.W001) otherwise.
CACHE_URL=locmemcache://

# Django admin site path (obscure it in production)
DJANGO_ADMIN_URL=django-admin/
LANGUAGE_CODE=ar
LOG_LEVEL=INFO

# Sessions: hard cap on total session age, regardless of refreshes (days)
SESSION_MAX_DAYS=90
# JWT lifetimes
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=30

# Retention used by `python manage.py purge_expired` (0 = keep forever)
RETAIN_ENDED_SESSIONS_DAYS=30
RETAIN_READ_NOTIFICATIONS_DAYS=180
RETAIN_AUDIT_LOGS_DAYS=0
RETAIN_OLD_FILE_VERSIONS=5

# Trusted reverse proxies in front of Django (production default 1 = nginx)
# NUM_PROXIES=1
# LOG_FORMAT=json
